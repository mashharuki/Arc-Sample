# ONRAMP_MODE: mock | sandbox | production
ONRAMP_MODE=mock

# Circle Console で発行した OnRamp 用 API キー。発行された文字列をそのまま貼る (形式: <ENV>_API_KEY:<keyId>:<keySecret>)。
# ブラウザに渡してはいけない。.env.local にだけ書くこと。
ONRAMP_API_KEY=

# iframe を埋め込むページのホスト名のみ (scheme/port/path/wildcard 不可。例: xxxx.trycloudflare.com)。
# まず空のまま localhost で試す。埋め込みに失敗する場合だけ、cloudflared/ngrok の host を指定して、その URL でアクセスする。
# (docs: 本番では localhost は CSP でブロックされる。sandbox で localhost が使えるかは未確認)
ONRAMP_REFERRER_DOMAIN=

# sandbox 用の上書き (docs 記載値)。空なら SDK の既定 (本番) を使う
ONRAMP_API_BASE_URL=https://api-test.circle.com
NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io
